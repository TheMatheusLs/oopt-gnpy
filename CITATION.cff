      family-names: "Santos"
      orcid: "https://orcid.org/0000-0002-8331-1087"
      affiliation: "Federal University of Pernambuco, Recife, Brazil"
    - given-names: "Karcius D. R."
      family-names: "Assis"
      affiliation: "Federal University of Bahia, Salvador, Brazil"
    - given-names: "Joaquim F."
      family-names: "Martins-Filho"
      affiliation: "Federal University of Pernambuco, Recife, Brazil"
    - given-names: "Raul C."
